{
  "name": "devtest-backend",
  "version": "0.1.0",
  "description": "DevTest API - iOS & Android app analysis",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "keywords": [
    "ios",
    "android",
    "app-analysis",
    "crash-reporting",
    "testing"
  ],
  "author": "DevTest",
  "license": "MIT",
  "dependencies": {
    "express": "4.18.2",
    "dotenv": "16.0.3",
    "cors": "2.8.5",
    "jsonwebtoken": "9.0.0",
    "bcrypt": "5.1.0",
    "axios": "1.4.0",
    "@prisma/client": "5.1.1",
    "bull": "4.11.3",
    "ioredis": "5.3.2",
    "multer": "1.4.5-lts.1",
    "@aws-sdk/client-s3": "3.370.0",
    "plist": "3.0.6",
    "yauzl": "3.0.0",
    "adm-zip": "0.5.10",
    "stripe": "12.16.0",
    "resend": "1.0.0",
    "express-rate-limit": "7.0.0",
    "helmet": "7.0.0",
    "zod": "3.22.2",
    "uuid": "9.0.0"
  },
  "devDependencies": {
    "@types/express": "4.17.17",
    "@types/node": "20.3.1",
    "@types/bcrypt": "5.0.0",
    "@types/jest": "29.5.2",
    "@types/uuid": "9.0.2",
    "@types/jsonwebtoken": "9.0.2",
    "@types/cors": "2.8.13",
    "@types/multer": "1.4.7",
    "@types/plist": "3.0.2",
    "typescript": "5.1.3",
    "tsx": "3.13.0",
    "jest": "29.5.0",
    "ts-jest": "29.1.0",
    "eslint": "8.43.0",
    "@typescript-eslint/eslint-plugin": "5.59.11",
    "@typescript-eslint/parser": "5.59.11",
    "prisma": "5.1.1"
  }
}
