{
  "name": "devtest-backend",
  "version": "0.1.0",
  "description": "DevTest API - iOS & Android app analysis",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "keywords": [
    "ios",
    "android",
    "app-analysis",
    "crash-reporting",
    "testing"
  ],
  "author": "DevTest",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.1.2",
    "bcrypt": "^5.1.1",
    "axios": "^1.6.0",
    "@prisma/client": "^5.8.0",
    "bull": "^4.11.5",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
    "@aws-sdk/client-s3": "^3.500.0",
    "plist": "^3.1.0",
    "yauzl": "^3.1.1",
    "adm-zip": "^0.5.10",
    "stripe": "^13.11.0",
    "resend": "^3.0.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "zod": "^3.22.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prisma": "^5.8.0"
  }
}
